<!--suppress SpellCheckingInspection -->
<table class="crit-wounds-table">
    <tbody>
    {{#each system.critWounds as |critWound i| }}
        <tr>
            <td class="flex">
                <div class="critwound-left">
                    <input hidden name="system.critWounds.{{i}}.id" type="text" value="{{critWound.id}}"/>
                    <select name="system.critWounds.{{i}}.effect">
                        {{#select (lookup this "effect") }}
                            {{#each (lookup ../config "CritSimple") as |critEffect j|}}
                                <option value="{{j}}">{{localize "WITCHER.CritWound.Simple"}} - {{localize
                                        critEffect}}</option>
                            {{/each}}
                            {{#each (lookup ../config "CritComplex") as |critEffect j|}}
                                <option value="{{j}}">{{localize "WITCHER.CritWound.Complex"}} - {{localize
                                        critEffect}}</option>
                            {{/each}}
                            {{#each (lookup ../config "CritDifficult") as |critEffect j|}}
                                <option value="{{j}}">{{localize "WITCHER.CritWound.Difficult"}} - {{localize
                                        critEffect}}</option>
                            {{/each}}
                            {{#each (lookup ../config "CritDeadly") as |critEffect j|}}
                                <option value="{{j}}">{{localize "WITCHER.CritWound.Deadly"}} - {{localize
                                        critEffect}}</option>
                            {{/each}}
                        {{/select}}
                    </select>
                    <select name="system.critWounds.{{i}}.mod">
                        {{#select (lookup this "mod") }}
                            {{#each (lookup ../config "CritMod") as |critWoundModifier j|}}
                                <option value="{{j}}">{{localize critWoundModifier}}</option>
                            {{/each}}
                        {{/select}}
                    </select>
                    <a class="delete-crit"><i class="fas fa-trash-alt" data-id="{{critWound.id}}"></i></a>
                    {{#if (eq critWound.mod "Treated")}}
                        {{#if critWound.isPermanent}}
                            <div class="critwounds-second-line healing-permanent">
                                {{localize "WITCHER.CritWound.HealingTime.Permanent"}}
                                <input hidden name="system.critWounds.{{i}}.daysHealed" type="number"
                                       data-dtype="Number" value="0"/>
                                <input hidden name="system.critWounds.{{i}}.healingTime" type="number"
                                       data-dtype="Number" value="0"/>
                            </div>
                        {{else}}
                            <div class="critwounds-second-line">
                                <label class="healing-time-lable">{{localize "WITCHER.CritWound.HealingTime.Label"}}:</label>
                                <input class="days-healed" name="system.critWounds.{{i}}.daysHealed" type="number"
                                       min="0" data-dtype="Number" value="{{critWound.daysHealed}}"/>
                                /
                                <input class="healing-time" name="system.critWounds.{{i}}.healingTime" type="number"
                                       min="1" data-dtype="Number" value="{{critWound.healingTime}}"/>
                            </div>
                        {{/if}}
                    {{else}}
                        <div class="critwounds-second-line healing-pending">
                            {{localize "WITCHER.CritWound.HealingTime.Pending"}}
                            <input hidden name="system.critWounds.{{i}}.daysHealed" type="number"
                                   data-dtype="Number" value="{{critWound.daysHealed}}"/>
                            <input hidden name="system.critWounds.{{i}}.healingTime" type="number"
                                   data-dtype="Number" value="{{critWound.healingTime}}"/>
                        </div>
                    {{/if}}
                    <textarea rows=3 name="system.critWounds.{{i}}.notes">{{critWound.notes}}</textarea>
                </div>
                <div class="critwounds-right">
                    <div class="crit-wound-description" name="system.critWounds.{{i}}.description"
                         data-id="CritDescription.{{critWound.effect}}">{{localize
                            (lookup ../config.CritDescription critWound.effect)}}</div>
                    <br/>
                    <div class="crit-wound-mod-description" name="system.critWounds.{{i}}.modDescription"
                         data-id="CritModDescription.{{critWound.effect}}.{{critWound.mod}}">{{localize
                            (lookup (lookup ../config.CritModDescription critWound.effect) critWound.mod)}}</div>
                </div>
            </td>
        </tr>
    {{/each}}
    </tbody>
</table>
