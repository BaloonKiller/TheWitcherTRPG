<form class="{{cssClass}}" autocomplete="off">
    {{>"systems/thewitchertrpg/templates/partials/item-header.hbs"}}
    <div class="item-options">
        <div class="item-column item-selector">
            <label>{{localize "WITCHER.Type"}}</label>
            <select name="system.type" id="type-select">
                {{#select item.system.type}}
                    <option value="toolkit">{{localize "WITCHER.Valuable.Toolkit"}}</option>
                    <option value="general">{{localize "WITCHER.Valuable.General"}}</option>
                    <option value="food-drink">{{localize "WITCHER.Valuable.Food&Drinks"}}</option>
                    <option value="clothing">{{localize "WITCHER.Valuable.Clothings"}}</option>
                    <option value="alchemical-item">{{localize "WITCHER.Valuable.AlchemicalItem"}}</option>
                    {{!-- <option value="service">{{localize "WITCHER.Valuable.Service"}}</option>
                    <option value="lodging">{{localize "WITCHER.Valuable.Loging"}}</option> --}}
                    <option value="mount-accessories">{{localize "WITCHER.Valuable.MountAccessories"}}</option>
                    <option value="quest-item">{{localize "WITCHER.Valuable.QuestItem"}}</option>
                {{/select}}
            </select>
        </div>
        <div class="item-column">
            <div class="item-row">
                <div class="item-second-column">
                    <label>{{localize "WITCHER.Item.Short.Availability"}}</label>
                    <select name="system.avail">
                        {{#select item.system.avail}}
                            {{#each config.Availability as |name value|}}
                                <option value="{{value}}">{{localize name}}</option>
                            {{/each}}
                        {{/select}}
                    </select>
                </div>
                <div class="item-second-column">
                    <div>{{localize "WITCHER.Valuable.Conceal"}}</div>
                    <select name="system.conceal">
                        {{#select item.system.conceal}}
                            {{#each config.Concealment as |name value|}}
                                <option value="{{value}}">{{localize name}}</option>
                            {{/each}}
                        {{/select}}
                    </select>
                </div>
            </div>
        </div>
    </div>
    {{!-- effect Tab --}}
    <div class="description">
        <textarea rows=5 name="system.description">{{item.system.description}}</textarea>
    </div>
    {{#if (eq item.system.type "mount-accessories")}}
    <div class="transport-accessory-fields">
        <label>
            <span>{{localize "WITCHER.Transport.SlotLabel"}}</span>
            <select name="system.transportSlot">
                {{#select item.system.transportProfile.slot}}
                <option value="other">{{localize "WITCHER.Transport.Slot.other"}}</option>
                <option value="saddle">{{localize "WITCHER.Transport.Slot.saddle"}}</option>
                <option value="blinders">{{localize "WITCHER.Transport.Slot.blinders"}}</option>
                <option value="barding">{{localize "WITCHER.Transport.Slot.barding"}}</option>
                <option value="storage">{{localize "WITCHER.Transport.Slot.storage"}}</option>
                <option value="upgrade">{{localize "WITCHER.Transport.Slot.upgrade"}}</option>
                {{/select}}
            </select>
        </label>
        <label><span>{{localize "WITCHER.Transport.ControlBonus"}}</span><input type="number" name="system.controlBonus" value="{{item.system.transportProfile.controlBonus}}" step="1"></label>
        <label><span>{{localize "WITCHER.Transport.SpeedBonus"}}</span><input type="number" name="system.speedBonus" value="{{item.system.transportProfile.speedBonus}}" step="1"></label>
        <label><span>{{localize "WITCHER.Transport.SpBonus"}}</span><input type="number" name="system.spBonus" value="{{item.system.transportProfile.spBonus}}" step="1"></label>
        <label><span>{{localize "WITCHER.Transport.HpBonus"}}</span><input type="number" name="system.hpBonus" value="{{item.system.transportProfile.hpBonus}}" step="1"></label>
        <label><span>{{localize "WITCHER.Transport.OccupancyBonus"}}</span><input type="number" name="system.occupancyBonus" value="{{item.system.transportProfile.occupancyBonus}}" step="1"></label>
        <label><span>{{localize "WITCHER.Transport.CargoCapacity"}}</span><input type="number" name="system.cargoCapacity" value="{{item.system.transportProfile.cargoCapacity}}" min="0" step="0.1"></label>
        <label><span>{{localize "WITCHER.Transport.ImprovementCost"}}</span><input type="number" name="system.improvementCost" value="{{item.system.transportProfile.improvementCost}}" min="0" step="1"></label>
    </div>
    {{/if}}
</form>
