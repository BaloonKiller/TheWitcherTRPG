<form class="{{cssClass}} verbal-combat-dialog" autocomplete="off">
    <h1>{{localize "WITCHER.verbalCombat.Title"}}</h1>
    <div class="verbal-combat-groups">
        <section>
        <h2>{{localize "WITCHER.verbalCombat.EmpatheticAttacks"}}</h2>
            <label><input name="verbalCombat" type="radio" value="Seduce" checked/><span>{{localize "WITCHER.verbalCombat.Seduce"}}</span></label>
            <label><input name="verbalCombat" type="radio" value="Persuade"/><span>{{localize "WITCHER.verbalCombat.Persuade"}}</span></label>
            <label><input name="verbalCombat" type="radio" value="Appeal"/><span>{{localize "WITCHER.verbalCombat.Appeal"}}</span></label>
            <label><input name="verbalCombat" type="radio" value="Befriend"/><span>{{localize "WITCHER.verbalCombat.Befriend"}}</span></label>
        </section>
        <section>
        <h2>{{localize "WITCHER.verbalCombat.AntagonisticAttacks"}}</h2>
            <label><input name="verbalCombat" type="radio" value="Deceive"/><span>{{localize "WITCHER.verbalCombat.Deceive"}}</span></label>
            <label><input name="verbalCombat" type="radio" value="Ridicule"/><span>{{localize "WITCHER.verbalCombat.Ridicule"}}</span></label>
            <label><input name="verbalCombat" type="radio" value="Intimidate"/><span>{{localize "WITCHER.verbalCombat.Intimidate"}}</span></label>
        </section>
        <section>
        <h2>{{localize "WITCHER.verbalCombat.Defences"}}</h2>
            <label><input name="verbalCombat" type="radio" value="Ignore"/><span>{{localize "WITCHER.verbalCombat.Ignore"}}</span></label>
            <label><input name="verbalCombat" type="radio" value="ChangeSubject"/><span>{{localize "WITCHER.verbalCombat.ChangeSubject"}}</span></label>
            <label><input name="verbalCombat" type="radio" value="Disengage"/><span>{{localize "WITCHER.verbalCombat.Disengage"}}</span></label>
        </section>
        <section>
        <h2>{{localize "WITCHER.verbalCombat.EmpatheticTools"}}</h2>
            <label><input name="verbalCombat" type="radio" value="Romance"/><span>{{localize "WITCHER.verbalCombat.Romance"}}</span></label>
            <label><input name="verbalCombat" type="radio" value="Study"/><span>{{localize "WITCHER.verbalCombat.Study"}}</span></label>
        </section>
        <section>
        <h2>{{localize "WITCHER.verbalCombat.AntagonisticTools"}}</h2>
            <label><input name="verbalCombat" type="radio" value="ImplyPersuade"/><span>{{localize "WITCHER.verbalCombat.ImplyPersuade"}}</span></label>
            <label><input name="verbalCombat" type="radio" value="ImplyDeceit"/><span>{{localize "WITCHER.verbalCombat.ImplyDeceit"}}</span></label>
            <label><input name="verbalCombat" type="radio" value="Bribe"/><span>{{localize "WITCHER.verbalCombat.Bribe"}}</span></label>
        </section>
        <div class="verbal-combat-modifiers">
            <label><span>{{localize "WITCHER.Chat.VerbalRollModifier"}}</span><input type="number" name="customModifiers" value="0" step="1"/></label>
            <label><span>{{localize "WITCHER.Chat.VerbalDamageModifier"}}</span><input type="number" name="customDamageModifiers" value="0" step="1"/></label>
        </div>
    </div>
</form>
